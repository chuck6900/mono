		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu  data/net_4_0/Makefile'; \
	cd $(top_srcdir) && \
	  $(AUTOMAKE) --gnu  data/net_4_0/Makefile
